# Groq Cloud API Key (Get for free at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Telegram Bot Token (If using Telegram)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Telegram Bot Password (Set your own password)
BOT_PASSWORD=dad2026

# ==========================================
# Company Information (สำหรับใบเสนอราคา)
# ==========================================

# ชื่อบริษัท/ร้านค้า
COMPANY_NAME=บริษัท ตัวอย่าง จำกัด

# ที่อยู่บริษัท (เต็ม)
COMPANY_ADDRESS=123 ถนนสุขุมวิท แขวงคลองเตย เขตคลองเตย กรุงเทพมหานคร 10110

# เบอร์โทรศัพท์
COMPANY_PHONE=081-234-5678

# เลขประจำตัวผู้เสียภาษีอากร (13 หลัก)
COMPANY_TAX_ID=1234567890123

# ชื่อผู้เสนอราคา
QUOTER_FIRSTNAME=สมชาย

# นามสกุลผู้เสนอราคา
QUOTER_LASTNAME=ใจดี
